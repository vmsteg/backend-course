                  "pm.test(\"Статус 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Ответ в формате JSON\", function () {\r\n    pm.response.to.be.json;\r\n});\r\n\r\npm.test(\"Есть поле total\", function () {\r\n    pm.expect(pm.response.json()).to.have.property('total');\r\n});\r\n\r\npm.test(\"Есть массив movies\", function () {\r\n    pm.expect(pm.response.json()).to.have.property('movies');\r\n});\r\n\r\npm.test(\"total равно 5\", function () {\r\n    pm.expect(pm.response.json().total).to.eql(5);\r\n});"
                ]
              }
            }
